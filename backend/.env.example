DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=maxbud_user
DB_PASSWORD=CHANGE_ME
DB_NAME=maxbud_db
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_48_CHAR_SECRET
JWT_MINUTES=60
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173
# Required for invitation emails: a reachable public HTTPS frontend origin.
# For local testing, use the actual HTTPS URL generated by your temporary tunnel.
# No localhost or FRONTEND_ORIGIN fallback is used for email links.
PUBLIC_FRONTEND_URL=
# Required for invitation email. Gmail uses smtp.gmail.com, STARTTLS/587 or SSL/465.
# Use a Google App Password for SMTP_USERNAME, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
